<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="https://sensei-otasuke.github.io/teacher-tools/shisha/" />
  <title>視写＆ノート見本メーカー｜縦書き・横書き・なぞり書き・ふりがな自動配置【センセイボックス】</title>
  <meta name="description" content="小学校の視写プリントやノートの書き方見本（めあて・まとめ枠・指導吹き出しつき）をブラウザから実寸印刷できる無料Webツール。縦書きの句読点・拗音自動配置、カッコ書きふりがな対応、なぞり書きモード、A4・A3・B5・B4実寸サイズ＆マス数自由指定に対応。">
  <meta name="keywords" content="視写 プリント 作成 無料, ノート 見本 作成 小学校, 縦書き マス目 プリント, なぞり書き プリント 作成, 国語 ノート 指導, 十字リーダー 視写, センセイボックス">
  <meta name="robots" content="index, follow">

  <meta property="og:title" content="視写＆ノート見本メーカー｜縦書き・なぞり書き・ノート指導見本を即印刷">
  <meta property="og:description" content="文章を入れるだけで視写プリント（見本＋空欄／なぞり書き）やノートの書き方見本を自動生成。縦書き句読点・ふりがな自動配置・A4/B5実寸印刷対応。">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://sensei-otasuke.github.io/teacher-tools/shisha/">
  <meta property="og:image" content="https://sensei-otasuke.github.io/teacher-tools/logo.png">
  <meta property="og:site_name" content="センセイボックス">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "視写＆ノート見本メーカー",
    "url": "https://sensei-otasuke.github.io/teacher-tools/shisha/",
    "description": "小学校の視写プリント（見本＋空欄・なぞり書き）やノートの書き方見本を実寸印刷できる教員向け無料Webツール。",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY" }
  }
  </script>

  <link rel="icon" href="../logo.png" type="image/png">
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@700;900&family=M+PLUS+Rounded+1c:wght@500;700;800;900&family=Yuji+Syuku&family=Klee+One:wght@600&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- 動的印刷用紙サイズ定義 -->
  <style id="dynamicPageStyle">
    @page {
      size: A4 portrait;
      margin: 0;
    }
  </style>

  <style>
    body { font-family: 'M PLUS Rounded 1c', sans-serif; }
    .font-mono-tech { font-family: 'Chivo Mono', monospace; }
    /* 学校PCのUD教科書体・Mac/iPadの游教科書体を最優先し、未導入環境はKlee Oneで補完 */
    .font-kyokasho {
      font-family: "UD デジタル 教科書体 NK-R", "UD デジタル 教科書体 N-R", "UD Digi Kyokasho NK-R", "UD Digi Kyokasho N-R", "游教科書体", "YuKyokasho", "Hiragino Maru Gothic ProN", "Klee One", serif;
    }

    /* プレビュー用紙の影と質感 */
    .paper-sheet {
      background-color: #ffffff;
      box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.12), 0 4px 10px -2px rgba(15, 23, 42, 0.06);
      transform-origin: top center;
      transition: transform 0.2s ease;
    }

    /* 印刷用スタイル（角丸枠・影・背景を完全消去し純粋な用紙として出力） */
    @media print {
      @page {
        margin: 0 !important;
      }
      html, body {
        background: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: 100% !important;
        overflow: hidden !important;
      }
      header, #leftColumn, #previewToolbar, #printTipBanner {
        display: none !important;
      }
      main, #rightColumn, #previewViewport {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        min-height: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        background: #ffffff !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        overflow: hidden !important;
      }
      #paperSheet {
        transform: none !important;
        box-shadow: none !important;
        margin: 0 !important;
        border: none !important;
        border-radius: 0 !important;
        background: #ffffff !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

  <!-- ヘッダー -->
  <header class="bg-white/90 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <a href="../" class="p-2 text-slate-400 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition" title="ポータルへ戻る">
          <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-indigo-100 border border-indigo-200 flex items-center justify-center text-xl">
            ✍️
          </div>
          <div>
            <h1 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
              <span>視写＆ノート見本メーカー</span>
              <span class="hidden sm:inline text-[10px] font-mono-tech font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 px-2 py-0.5 rounded-full">教科書体・縦横対応</span>
            </h1>
            <p class="text-[10px] text-slate-400 font-bold hidden sm:block">視写プリント（お手本＋空欄・なぞり書き）・ノート書き方見本を実寸印刷</p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button id="headerPrintBtn" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 active:scale-98 text-white font-black text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center gap-1.5">
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>この用紙を印刷する</span>
        </button>
      </div>
    </div>
  </header>

  <!-- メインエリア -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- 左カラム：設定パネル (5カラム) -->
    <div id="leftColumn" class="lg:col-span-5 flex flex-col gap-4">

      <!-- 0. 学年別・用途別ワンタッチプリセット -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-4 shadow-xs space-y-2.5">
        <span class="text-[11px] font-black text-slate-500 flex items-center gap-1">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-indigo-600"></i>
          <span>定番プリセット（1タップ設定＋例文セット）</span>
        </span>
        <div class="flex flex-wrap gap-1.5">
          <button data-preset="shisha_low" class="preset-chip px-2.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 font-black text-[11px] transition">1・2年 視写(12マス十字)</button>
          <button data-preset="shisha_trace" class="preset-chip px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 text-slate-700 font-bold text-[11px] transition">なぞり書き＋自力視写</button>
          <button data-preset="shisha_mid" class="preset-chip px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 text-slate-700 font-bold text-[11px] transition">3・4年 視写(15マス)</button>
          <button data-preset="note_kokugo" class="preset-chip px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 text-slate-700 font-bold text-[11px] transition">国語ノート見本(めあて枠)</button>
          <button data-preset="shisha_horiz" class="preset-chip px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-indigo-50 text-slate-700 font-bold text-[11px] transition">横書き視写(英語・ローマ字)</button>
        </div>
      </div>

      <!-- 1. プリントの種類（視写パターン）＆ 文字入力 -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-5 shadow-xs space-y-3.5">
        <h2 class="text-sm font-black text-slate-800 flex items-center gap-1.5">
          <span class="w-5 h-5 rounded-full bg-indigo-600 text-white text-xs flex items-center justify-center font-mono-tech">1</span>
          <span>プリントの種類とお手本テキスト</span>
        </h2>

        <!-- 出力パターン3種 -->
        <div class="grid grid-cols-3 gap-1.5 bg-slate-100 p-1 rounded-xl text-[11px] font-black">
          <button data-mode="copy_blank" class="shisha-mode-btn py-1.5 px-1 rounded-lg bg-white text-slate-900 shadow-2xs transition">見本＋空欄</button>
          <button data-mode="trace_blank" class="shisha-mode-btn py-1.5 px-1 rounded-lg text-slate-500 hover:text-slate-900 transition">なぞり＋空欄</button>
          <button data-mode="model_only" class="shisha-mode-btn py-1.5 px-1 rounded-lg text-slate-500 hover:text-slate-900 transition">見本のみ</button>
        </div>

        <!-- テキスト入力欄 -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-slate-600">お手本の文章（改行で行が変わります）</label>
            <button id="clearTextBtn" class="text-[11px] font-bold text-slate-400 hover:text-rose-600 transition">クリア</button>
          </div>
          <textarea id="sourceTextInput" rows="5" placeholder="ここにお手本の文章を入力してください。" class="w-full p-3 text-sm font-kyokasho font-semibold bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:border-indigo-500 focus:outline-none leading-relaxed"></textarea>
          <div id="overflowWarningBox" class="hidden text-[11px] font-bold text-rose-700 bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-xl flex items-center gap-1.5">
            <i data-lucide="alert-triangle" class="w-3.5 h-3.5 shrink-0"></i>
            <span id="overflowWarningText">1行のマス数を超えている行があります。</span>
          </div>
        </div>

        <!-- 便利な特殊記法ヘルプ＆ワンクリック挿入 -->
        <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-3 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-black text-slate-500">ワンクリック挿入（ノート見本・ルビ用）</span>
          </div>
          <div class="flex flex-wrap gap-1.5 text-[11px]">
            <button data-insert="【めあて】" class="insert-tag-btn px-2 py-1 rounded-lg bg-white border border-rose-200 text-rose-700 font-bold hover:bg-rose-50 transition">【めあて】赤枠</button>
            <button data-insert="【まとめ】" class="insert-tag-btn px-2 py-1 rounded-lg bg-white border border-sky-200 text-sky-700 font-bold hover:bg-sky-50 transition">【まとめ】青枠</button>
            <button data-insert="漢字(かんじ)" class="insert-tag-btn px-2 py-1 rounded-lg bg-white border border-slate-200 text-slate-700 font-bold hover:bg-slate-100 transition">漢字(ふりがな)</button>
            <button data-insert="≪１マスあける≫" class="insert-tag-btn px-2 py-1 rounded-lg bg-white border border-amber-200 text-amber-800 font-bold hover:bg-amber-50 transition">≪吹き出しメモ≫</button>
          </div>
          <p class="text-[10px] text-slate-400 font-bold leading-snug">
            ※ <code>漢字(かんじ)</code> でルビ自動配置、<code>【めあて】</code> で色枠強調、<code>≪メモ≫</code> で指導吹き出しを表示します。
          </p>
        </div>
      </div>

      <!-- 2. 用紙・書字方向・マス目の自由設定 -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-5 shadow-xs space-y-4">
        <h2 class="text-sm font-black text-slate-800 flex items-center gap-1.5">
          <span class="w-5 h-5 rounded-full bg-indigo-600 text-white text-xs flex items-center justify-center font-mono-tech">2</span>
          <span>用紙・マス目の自由設定</span>
        </h2>

        <!-- 用紙サイズ 4種 -->
        <div class="grid grid-cols-4 gap-1.5">
          <button data-paper="A4" class="paper-btn py-2 rounded-xl bg-indigo-600 text-white font-mono-tech font-black text-xs shadow-2xs transition">A4</button>
          <button data-paper="A3" class="paper-btn py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 font-mono-tech font-black text-xs transition">A3</button>
          <button data-paper="B5" class="paper-btn py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 font-mono-tech font-black text-xs transition">B5</button>
          <button data-paper="B4" class="paper-btn py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 font-mono-tech font-black text-xs transition">B4</button>
        </div>

        <!-- 用紙の向き ＆ 書字方向（縦書き・横書き） -->
        <div class="grid grid-cols-2 gap-2">
          <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-black">
            <button id="orientPortraitBtn" class="flex-1 py-1.5 rounded-lg bg-white text-slate-900 shadow-2xs transition">用紙：縦</button>
            <button id="orientLandscapeBtn" class="flex-1 py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition">用紙：横</button>
          </div>

          <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-black">
            <button id="dirVerticalBtn" class="flex-1 py-1.5 rounded-lg bg-white text-indigo-700 shadow-2xs transition">縦書き</button>
            <button id="dirHorizontalBtn" class="flex-1 py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition">横書き</button>
          </div>
        </div>

        <!-- マス指定モード切替（実寸mm / マス数指定） -->
        <div class="grid grid-cols-2 gap-1.5 bg-slate-100 p-1 rounded-xl text-xs font-black">
          <button id="modeCountBtn" class="py-1.5 rounded-lg bg-white text-slate-900 shadow-2xs transition">マス数指定（字数×行数）</button>
          <button id="modeMmBtn" class="py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition">実寸サイズ指定（mm）</button>
        </div>

        <!-- A. マス数指定（字数 × 行数） -->
        <div id="countControlPanel" class="space-y-2.5">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label id="charsPerLineLabel" class="block text-[11px] font-bold text-slate-500 mb-1">1行のマス数（縦の字数）</label>
              <input id="charsPerLineInput" type="number" min="4" max="40" value="12" class="w-full p-2 text-center font-mono-tech font-black text-sm bg-slate-50 border border-slate-200 rounded-xl focus:border-indigo-500 focus:outline-none">
            </div>
            <div>
              <label id="linesCountLabel" class="block text-[11px] font-bold text-slate-500 mb-1">全体の行数（列数）</label>
              <input id="linesCountInput" type="number" min="2" max="30" value="8" class="w-full p-2 text-center font-mono-tech font-black text-sm bg-slate-50 border border-slate-200 rounded-xl focus:border-indigo-500 focus:outline-none">
            </div>
          </div>
          <p id="calculatedMmInfo" class="text-[11px] font-bold text-indigo-700 bg-indigo-50 px-3 py-1.5 rounded-lg text-center">
            自動計算された1マスのサイズ：16.5 mm
          </p>
        </div>

        <!-- B. 実寸サイズ指定（mm） -->
        <div id="mmControlPanel" class="hidden space-y-2.5">
          <div class="flex flex-wrap gap-1.5">
            <button data-mm="10" class="mm-chip px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-mono-tech font-bold text-xs">10mm</button>
            <button data-mm="12" class="mm-chip px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-mono-tech font-bold text-xs">12mm</button>
            <button data-mm="15" class="mm-chip px-2.5 py-1 rounded-lg bg-indigo-100 text-indigo-800 ring-2 ring-indigo-400 font-mono-tech font-black text-xs">15mm</button>
            <button data-mm="18" class="mm-chip px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-mono-tech font-bold text-xs">18mm</button>
            <button data-mm="20" class="mm-chip px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-mono-tech font-bold text-xs">20mm</button>
            <button data-mm="22" class="mm-chip px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-mono-tech font-bold text-xs">22mm</button>
          </div>
          <div class="flex items-center justify-between pt-1">
            <label class="text-xs font-bold text-slate-600">1マスの大きさ（自由入力）</label>
            <div class="flex items-center gap-1.5">
              <input id="cellSizeMmInput" type="number" min="5" max="40" step="0.5" value="15" class="w-20 p-1.5 text-center font-mono-tech font-black text-sm bg-slate-50 border border-slate-200 rounded-xl focus:border-indigo-500 focus:outline-none">
              <span class="text-xs font-bold text-slate-500">mm</span>
            </div>
          </div>
        </div>

        <!-- 補助オプション（ふりがな欄・十字リーダー・行間） -->
        <div class="pt-2 border-t border-slate-100 grid grid-cols-2 gap-2 text-xs">
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 cursor-pointer font-bold text-slate-700">
            <input id="furiganaColCheck" type="checkbox" checked class="w-4 h-4 accent-indigo-600 rounded">
            <span>ふりがな欄つき</span>
          </label>

          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 cursor-pointer font-bold text-slate-700">
            <input id="crossLeaderCheck" type="checkbox" checked class="w-4 h-4 accent-indigo-600 rounded">
            <span>十字リーダー（点線）</span>
          </label>
        </div>
      </div>

      <!-- 3. 線の色・濃さ ＆ ヘッダー設定 -->
      <div class="bg-white rounded-3xl border border-slate-200/90 p-5 shadow-xs space-y-3.5">
        <h2 class="text-sm font-black text-slate-800 flex items-center gap-1.5">
          <span class="w-5 h-5 rounded-full bg-indigo-600 text-white text-xs flex items-center justify-center font-mono-tech">3</span>
          <span>線の色・名前欄の設定</span>
        </h2>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 mb-1">マス目のカラー</label>
            <div class="grid grid-cols-3 gap-1.5">
              <button data-color="black" class="color-btn py-2 rounded-xl border border-slate-200 bg-white text-slate-700 font-black text-xs transition flex items-center justify-center gap-1">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>黒
              </button>
              <button data-color="blue" class="color-btn py-2 rounded-xl border border-slate-200 bg-white text-sky-700 font-black text-xs transition flex items-center justify-center gap-1">
                <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span>青
              </button>
              <button data-color="green" class="color-btn py-2 rounded-xl border-2 border-emerald-600 bg-emerald-600 text-white font-black text-xs transition flex items-center justify-center gap-1">
                <span class="w-2.5 h-2.5 rounded-full bg-white"></span>緑
              </button>
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-500 mb-1">なぞり文字の濃さ</label>
            <select id="traceShadeSelect" class="w-full p-2 text-xs font-bold bg-slate-50 border border-slate-200 rounded-xl focus:border-indigo-500 focus:outline-none">
              <option value="light">うすめ（高学年・仕上げ）</option>
              <option value="normal" selected>ふつう（標準）</option>
              <option value="dark">こいめ（1年生・支援用）</option>
            </select>
          </div>
        </div>

        <div class="space-y-2 pt-1 text-xs">
          <div class="flex items-center justify-between gap-2">
            <label class="flex items-center gap-2 cursor-pointer font-bold text-slate-700">
              <input id="showHeaderCheck" type="checkbox" checked class="w-4 h-4 accent-indigo-600 rounded">
              <span>上部に「年・組・番・なまえ」欄をつける</span>
            </label>
          </div>

          <input id="sheetTitleInput" type="text" value="ししゃ プリント" placeholder="プリントのタイトル（空欄でもOK）" class="w-full p-2 text-xs font-bold bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:outline-none">
        </div>
      </div>

    </div>

    <!-- 右カラム：リアルタイム用紙プレビュー (7カラム) -->
    <div id="rightColumn" class="lg:col-span-7 flex flex-col gap-3">
      
      <!-- プレビュー上部ツールバー -->
      <div id="previewToolbar" class="bg-white rounded-2xl border border-slate-200/90 px-4 py-2.5 shadow-2xs flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2 text-xs font-black text-slate-700">
          <span id="paperSpecBadge" class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-800 border border-indigo-200 font-mono-tech">A4 縦（210×297mm）</span>
          <span id="gridCountBadge" class="text-slate-500 font-bold">1行12字 × 8行</span>
        </div>

        <div class="flex items-center gap-2">
          <!-- 電子黒板投影用：お手本隠しトグル -->
          <button id="toggleHideModelBtn" class="px-2.5 py-1 rounded-xl bg-slate-100 hover:bg-amber-100 text-slate-700 font-black text-[11px] transition flex items-center gap-1" title="電子黒板投影時に見本文字を一時的に隠します">
            <i data-lucide="eye-off" class="w-3.5 h-3.5"></i>
            <span>見本隠し</span>
          </button>

          <div class="inline-flex rounded-xl bg-slate-100 p-1 text-[11px] font-bold">
            <button id="zoomFitBtn" class="px-2.5 py-0.5 rounded-lg bg-white text-slate-900 shadow-2xs transition">全体表示</button>
            <button id="zoom100Btn" class="px-2.5 py-0.5 rounded-lg text-slate-500 hover:text-slate-900 transition">実寸拡大</button>
          </div>
        </div>
      </div>

      <!-- 印刷時のアドバイスバー -->
      <div id="printTipBanner" class="bg-amber-50 border border-amber-200/80 text-amber-900 text-[11px] font-bold px-3.5 py-2 rounded-xl flex items-center gap-2">
        <i data-lucide="info" class="w-4 h-4 text-amber-600 shrink-0"></i>
        <span>印刷画面では倍率を<b>「100%（実際のサイズ）」</b>にすると、指定したマス目サイズ通りに印刷されます。</span>
      </div>

      <!-- 用紙プレビュー表示領域 -->
      <div id="previewViewport" class="flex-1 bg-slate-200/70 rounded-3xl border border-slate-300/70 p-4 sm:p-6 overflow-auto flex justify-center items-start min-h-[560px]">
        <!-- 実際の印刷対象シート（mm単位で精密描画） -->
        <div id="paperSheet" class="paper-sheet relative box-border flex flex-col justify-between">
          <!-- JSでSVGマス目・お手本文字・ノートマーカーを描画 -->
        </div>
      </div>

    </div>

  </main>

  <script>
    // ==========================================
    // 1. JIS規格 用紙寸法定義（mm）
    // ==========================================
    const PAPER_SIZES = {
      A4: { w: 210, h: 297 },
      A3: { w: 297, h: 420 },
      B5: { w: 182, h: 257 },
      B4: { w: 257, h: 364 }
    };

    const COLOR_PALETTES = {
      black: { main: '#475569', sub: '#94a3b8', bold: '#1e293b', text: '#0f172a' },
      blue:  { main: '#0ea5e9', sub: '#7dd3fc', bold: '#0369a1', text: '#0f172a' },
      green: { main: '#10b981', sub: '#6ee7b7', bold: '#047857', text: '#0f172a' }
    };

    const TRACE_SHADES = {
      light: '#cbd5e1',
      normal: '#94a3b8',
      dark: '#64748b'
    };

    // ==========================================
    // 2. アプリ状態管理
    // ==========================================
    const state = {
      paper: 'A4',
      orientation: 'portrait', // 'portrait' | 'landscape'
      direction: 'vertical',   // 'vertical' | 'horizontal'
      shishaMode: 'copy_blank', // 'copy_blank' | 'trace_blank' | 'model_only'
      sizeMode: 'count',       // 'count' | 'mm'
      charsPerLine: 12,
      linesCount: 8,
      cellMm: 15,
      hasFurigana: true,
      crossLeader: true,
      color: 'green',
      traceShade: 'normal',
      showHeader: true,
      sheetTitle: 'ししゃ プリント',
      hideModelText: false,
      zoomMode: 'fit',
      rawText: '　春(はる)の　朝(あさ)、\n小さな　花が　さきました。\n「きれいだな。」\nと、声(こえ)が　出ました。'
    };

    // ==========================================
    // 3. テキストパーサー（ルビ・枠強調・吹き出し・縦書き約物処理）
    // ==========================================
    // 縦書き時に回転や位置補正が必要な文字
    const ROTATE_90_CHARS = new Set(['ー', '―', '…', '〜', '～', '（', '）', '(', ')', '「', '」', '『', '』', '【', '】', '［', '］', '＜', '＞', '＝', '=']);
    const TOP_RIGHT_PUNCT = new Set(['、', '。', '，', '．', ',', '.']);
    const SMALL_KANA = new Set(['っ', 'ゃ', 'ゅ', 'ょ', 'ぁ', 'ぃ', 'ぅ', 'ぇ', 'ぉ', 'ゎ', 'ッ', 'ャ', 'ュ', 'ョ', 'ァ', 'ィ', 'ゥ', 'ェ', 'ォ', 'ヮ']);

    function parseLineToCells(lineText) {
      // 行末の ≪メモ≫ を吹き出しとして抽出
      let callout = '';
      let cleanLine = lineText.replace(/≪([^≫]+)≫/g, (_, memo) => {
        callout = memo.trim();
        return '';
      });

      // 【めあて】などの強調タグを検出（タグ自体は枠表示にして中身の文字を展開）
      // 例: "【めあて】漢字(かんじ)を正しく書こう。" -> 「めあて」を枠囲みマーカー付きで展開
      const tokens = [];
      let i = 0;
      while (i < cleanLine.length) {
        // 【...】タグチェック
        if (cleanLine[i] === '【') {
          const closeIdx = cleanLine.indexOf('】', i + 1);
          if (closeIdx !== -1 && closeIdx - i <= 8) {
            const label = cleanLine.slice(i + 1, closeIdx);
            const badgeColor = label.includes('まとめ') ? 'blue' : (label.includes('ふりかえり') ? 'emerald' : 'rose');
            for (let k = 0; k < label.length; k++) {
              tokens.push({
                char: label[k],
                ruby: '',
                badge: badgeColor,
                badgePos: k === 0 ? 'start' : (k === label.length - 1 ? 'end' : 'mid'),
                badgeSingle: label.length === 1
              });
            }
            i = closeIdx + 1;
            continue;
          }
        }

        // 漢字(ふりがな) チェック（直前の1〜4文字の漢字・カタカナ列にルビを振る）
        if (cleanLine[i] === '(' || cleanLine[i] === '（') {
          const closeChar = cleanLine[i] === '(' ? ')' : '）';
          const closeIdx = cleanLine.indexOf(closeChar, i + 1);
          if (closeIdx !== -1 && tokens.length > 0 && closeIdx - i <= 15) {
            const rubyStr = cleanLine.slice(i + 1, closeIdx);
            // 直前の連続する漢字（またはアルファベット）を遡る
            let targetCount = 0;
            for (let b = tokens.length - 1; b >= 0 && targetCount < 5; b--) {
              const ch = tokens[b].char;
              if (/[\u4E00-\u9FFF々ヶ〆]/.test(ch)) {
                targetCount++;
              } else {
                break;
              }
            }
            if (targetCount === 0) targetCount = 1; // 漢字以外なら直前1文字に割り当て

            const startIdx = tokens.length - targetCount;
            // ルビ文字を各対象マスへ均等配分
            for (let t = 0; t < targetCount; t++) {
              const rStart = Math.floor((t * rubyStr.length) / targetCount);
              const rEnd = Math.floor(((t + 1) * rubyStr.length) / targetCount);
              tokens[startIdx + t].ruby = rubyStr.slice(rStart, rEnd);
            }
            i = closeIdx + 1;
            continue;
          }
        }

        tokens.push({ char: cleanLine[i], ruby: '', badge: null });
        i++;
      }

      return { cells: tokens, callout };
    }

    // ==========================================
    // 4. 印刷CSS（@page）同期 ＆ プレビュー倍率調整
    // ==========================================
    function syncPrintPageRule() {
      const styleEl = document.getElementById('dynamicPageStyle');
      styleEl.textContent = `@page { size: ${state.paper} ${state.orientation}; margin: 0; }`;
    }

    function applyPreviewScale() {
      const viewport = document.getElementById('previewViewport');
      const sheet = document.getElementById('paperSheet');
      const base = PAPER_SIZES[state.paper];
      const paperW = state.orientation === 'portrait' ? base.w : base.h;
      const paperH = state.orientation === 'portrait' ? base.h : base.w;

      if (state.zoomMode === '100') {
        sheet.style.transform = 'scale(1)';
        sheet.style.marginBottom = '0px';
        return;
      }

      const pxPerMm = 3.7795275591;
      const sheetPxW = paperW * pxPerMm;
      const sheetPxH = paperH * pxPerMm;
      const availW = Math.max(260, viewport.clientWidth - 48);

      const scale = Math.min(1, availW / sheetPxW);
      sheet.style.transform = `scale(${scale})`;
      const reducedHeight = sheetPxH * (1 - scale);
      sheet.style.marginBottom = `-${reducedHeight}px`;
    }

    // ==========================================
    // 5. SVGベクター視写・ノート見本レンダリングエンジン
    // ==========================================
    function renderSheet() {
      syncPrintPageRule();

      const base = PAPER_SIZES[state.paper];
      const paperW = state.orientation === 'portrait' ? base.w : base.h;
      const paperH = state.orientation === 'portrait' ? base.h : base.w;
      const margin = 12;

      const palette = COLOR_PALETTES[state.color];
      const traceColor = TRACE_SHADES[state.traceShade];
      const headerH = state.showHeader ? 14 : 0;

      const availW = paperW - margin * 2;
      const availH = paperH - margin * 2 - headerH;

      const furiganaRatio = state.hasFurigana ? 0.36 : 0;
      const isVertical = state.direction === 'vertical';

      // 入力テキストを行単位にパース
      const rawLines = state.rawText.split('\n');
      const parsedLines = rawLines.map(parseLineToCells);

      // 出力行リストを構築（見本＋空欄 / なぞり＋空欄 / 見本のみ）
      // rowType: 'model' | 'trace' | 'blank'
      const renderRows = [];
      let totalTargetLines = state.linesCount;

      if (state.sizeMode === 'count') {
        if (state.shishaMode === 'model_only') {
          for (let i = 0; i < totalTargetLines; i++) {
            const p = parsedLines[i] || { cells: [], callout: '' };
            renderRows.push({ type: 'model', cells: p.cells, callout: p.callout });
          }
        } else {
          // 2行1セット（見本 or なぞり ＋ 空欄）
          const pairType = state.shishaMode === 'trace_blank' ? 'trace' : 'model';
          let srcIdx = 0;
          while (renderRows.length < totalTargetLines) {
            const p = parsedLines[srcIdx] || { cells: [], callout: '' };
            renderRows.push({ type: pairType, cells: p.cells, callout: p.callout });
            if (renderRows.length < totalTargetLines) {
              renderRows.push({ type: 'blank', cells: [], callout: '' });
            }
            srcIdx++;
          }
        }
      }

      // マスサイズと行列数の決定
      let cellSize = state.cellMm;
      let charsPerLine = state.charsPerLine;
      let numLines = state.linesCount;

      if (state.sizeMode === 'count') {
        charsPerLine = Math.max(4, state.charsPerLine);
        numLines = Math.max(2, state.linesCount);

        if (isVertical) {
          // 縦書き：1行は縦に charsPerLine マス、横に numLines 列（各列にふりがな欄）
          const maxCellH = availH / charsPerLine;
          const maxCellW = availW / (numLines * (1 + furiganaRatio));
          cellSize = Math.max(5, Math.floor(Math.min(maxCellW, maxCellH) * 10) / 10);
        } else {
          // 横書き：1行は横に charsPerLine マス、縦に numLines 行（各行にふりがな欄）
          const maxCellW = availW / charsPerLine;
          const maxCellH = availH / (numLines * (1 + furiganaRatio));
          cellSize = Math.max(5, Math.floor(Math.min(maxCellW, maxCellH) * 10) / 10);
        }
        document.getElementById('calculatedMmInfo').textContent =
          `自動計算された1マスのサイズ：${cellSize.toFixed(1)} mm`;
      } else {
        cellSize = Math.max(5, Math.min(40, state.cellMm));
        if (isVertical) {
          charsPerLine = Math.max(4, Math.floor(availH / cellSize));
          numLines = Math.max(2, Math.floor(availW / (cellSize * (1 + furiganaRatio))));
        } else {
          charsPerLine = Math.max(4, Math.floor(availW / cellSize));
          numLines = Math.max(2, Math.floor(availH / (cellSize * (1 + furiganaRatio))));
        }

        // mm指定時は計算された numLines 分の renderRows を再生成
        renderRows.length = 0;
        if (state.shishaMode === 'model_only') {
          for (let i = 0; i < numLines; i++) {
            const p = parsedLines[i] || { cells: [], callout: '' };
            renderRows.push({ type: 'model', cells: p.cells, callout: p.callout });
          }
        } else {
          const pairType = state.shishaMode === 'trace_blank' ? 'trace' : 'model';
          let srcIdx = 0;
          while (renderRows.length < numLines) {
            const p = parsedLines[srcIdx] || { cells: [], callout: '' };
            renderRows.push({ type: pairType, cells: p.cells, callout: p.callout });
            if (renderRows.length < numLines) {
              renderRows.push({ type: 'blank', cells: [], callout: '' });
            }
            srcIdx++;
          }
        }
      }

      // 文字数オーバーチェック（警告表示）
      const overflowLines = [];
      parsedLines.forEach((p, idx) => {
        if (p.cells.length > charsPerLine) {
          overflowLines.push(`${idx + 1}行目（${p.cells.length}字）`);
        }
      });
      const warnBox = document.getElementById('overflowWarningBox');
      if (overflowLines.length > 0) {
        warnBox.classList.remove('hidden');
        document.getElementById('overflowWarningText').textContent =
          `1行のマス数（${charsPerLine}字）を超えています：${overflowLines.join('、')}`;
      } else {
        warnBox.classList.add('hidden');
      }

      // グリッド全体の物理寸法（mm）
      const unitTrack = cellSize * (1 + furiganaRatio);
      const totalGridW = isVertical
        ? +(numLines * unitTrack).toFixed(3)
        : +(charsPerLine * cellSize).toFixed(3);
      const totalGridH = isVertical
        ? +(charsPerLine * cellSize).toFixed(3)
        : +(numLines * unitTrack).toFixed(3);

      document.getElementById('paperSpecBadge').textContent =
        `${state.paper} ${state.orientation === 'portrait' ? '縦' : '横'}（${paperW}×${paperH}mm）`;
      document.getElementById('gridCountBadge').textContent =
        `1行${charsPerLine}字 × ${numLines}行（1マス ${cellSize}mm）`;

      const svgParts = [];

      // ==========================================
      // 枠線の独立描画（2重線太り防止）
      // ==========================================
      if (isVertical) {
        // 縦書き：右から左へ列（lineIdx = 0 が一番右の列）
        for (let l = 0; l < numLines; l++) {
          const colLeftX = (numLines - 1 - l) * unitTrack;
          if (l < numLines - 1) {
            const boundaryX = +colLeftX.toFixed(3);
            svgParts.push(
              `<line x1="${boundaryX}" y1="0" x2="${boundaryX}" y2="${totalGridH}" stroke="${palette.main}" stroke-width="0.26"/>`
            );
          }
          if (state.hasFurigana) {
            const furiSepX = +(colLeftX + cellSize).toFixed(3);
            svgParts.push(
              `<line x1="${furiSepX}" y1="0" x2="${furiSepX}" y2="${totalGridH}" stroke="${palette.main}" stroke-width="0.2"/>`
            );
          }
        }
        // 横のマス仕切り線
        for (let c = 1; c < charsPerLine; c++) {
          const y = +(c * cellSize).toFixed(3);
          svgParts.push(
            `<line x1="0" y1="${y}" x2="${totalGridW}" y2="${y}" stroke="${palette.main}" stroke-width="0.24"/>`
          );
        }
      } else {
        // 横書き：上から下へ行（lineIdx = 0 が一番上の行）
        for (let l = 0; l < numLines; l++) {
          const rowTopY = l * unitTrack;
          if (l > 0) {
            const boundaryY = +rowTopY.toFixed(3);
            svgParts.push(
              `<line x1="0" y1="${boundaryY}" x2="${totalGridW}" y2="${boundaryY}" stroke="${palette.main}" stroke-width="0.26"/>`
            );
          }
          if (state.hasFurigana) {
            const furiSepY = +(rowTopY + cellSize * furiganaRatio).toFixed(3);
            svgParts.push(
              `<line x1="0" y1="${furiSepY}" x2="${totalGridW}" y2="${furiSepY}" stroke="${palette.main}" stroke-width="0.2"/>`
            );
          }
        }
        // 縦のマス仕切り線
        for (let c = 1; c < charsPerLine; c++) {
          const x = +(c * cellSize).toFixed(3);
          svgParts.push(
            `<line x1="${x}" y1="0" x2="${x}" y2="${totalGridH}" stroke="${palette.main}" stroke-width="0.24"/>`
          );
        }
      }

      // ==========================================
      // 十字リーダー（点線）
      // ==========================================
      if (state.crossLeader) {
        const dash = +(Math.max(0.5, cellSize * 0.07)).toFixed(2);
        for (let l = 0; l < numLines; l++) {
          for (let c = 0; c < charsPerLine; c++) {
            const cellX = isVertical
              ? (numLines - 1 - l) * unitTrack
              : c * cellSize;
            const cellY = isVertical
              ? c * cellSize
              : l * unitTrack + (state.hasFurigana ? cellSize * furiganaRatio : 0);

            const midX = +(cellX + cellSize / 2).toFixed(3);
            const midY = +(cellY + cellSize / 2).toFixed(3);
            svgParts.push(
              `<line x1="${midX}" y1="${+cellY.toFixed(3)}" x2="${midX}" y2="${+(cellY + cellSize).toFixed(3)}" stroke="${palette.sub}" stroke-width="0.18" stroke-dasharray="${dash},${dash}"/>`,
              `<line x1="${+cellX.toFixed(3)}" y1="${midY}" x2="${+(cellX + cellSize).toFixed(3)}" y2="${midY}" stroke="${palette.sub}" stroke-width="0.18" stroke-dasharray="${dash},${dash}"/>`
            );
          }
        }
      }

      // ==========================================
      // お手本文字・ふりがな・ノート見本マーカー描画
      // ==========================================
      const fontSize = +(cellSize * 0.68).toFixed(2);
      const rubyFontSize = +(cellSize * furiganaRatio * 0.62).toFixed(2);

      for (let l = 0; l < numLines; l++) {
        const rowData = renderRows[l];
        if (!rowData || rowData.type === 'blank') continue;
        if (state.hideModelText) continue;

        const isTrace = rowData.type === 'trace';
        const textFill = isTrace ? traceColor : palette.text;

        const maxCells = Math.min(charsPerLine, rowData.cells.length);
        for (let c = 0; c < maxCells; c++) {
          const item = rowData.cells[c];
          const cellX = isVertical
            ? (numLines - 1 - l) * unitTrack
            : c * cellSize;
          const cellY = isVertical
            ? c * cellSize
            : l * unitTrack + (state.hasFurigana ? cellSize * furiganaRatio : 0);

          // 【めあて】などの強調枠マーカー
          if (item.badge) {
            const strokeCol = item.badge === 'blue' ? '#0284c7' : (item.badge === 'emerald' ? '#059669' : '#e11d48');
            const fillBg = item.badge === 'blue' ? '#f0f9ff' : (item.badge === 'emerald' ? '#ecfdf5' : '#fff1f2');
            const inset = 0.55;
            svgParts.push(
              `<rect x="${+(cellX + inset).toFixed(3)}" y="${+(cellY + inset).toFixed(3)}" width="${+(cellSize - inset * 2).toFixed(3)}" height="${+(cellSize - inset * 2).toFixed(3)}" rx="0.8" fill="${fillBg}" stroke="${strokeCol}" stroke-width="0.45"/>`
            );
          }

          // 文字描画（空白はスキップ）
          if (item.char && item.char !== ' ' && item.char !== '　') {
            let cx = cellX + cellSize / 2;
            let cy = cellY + cellSize / 2;
            let transformAttr = '';
            let charFontSize = fontSize;

            if (isVertical) {
              if (TOP_RIGHT_PUNCT.has(item.char)) {
                // 句読点はマスの右上へ配置
                cx = cellX + cellSize * 0.74;
                cy = cellY + cellSize * 0.28;
              } else if (SMALL_KANA.has(item.char)) {
                // 促音・拗音はやや右上寄り・小さめ
                cx = cellX + cellSize * 0.62;
                cy = cellY + cellSize * 0.44;
                charFontSize = +(fontSize * 0.85).toFixed(2);
              } else if (ROTATE_90_CHARS.has(item.char)) {
                // 長音符・カッコ類は90度回転
                transformAttr = ` transform="rotate(90 ${cx.toFixed(3)} ${cy.toFixed(3)})"`;
              }
            }

            const badgeTextColor = item.badge
              ? (item.badge === 'blue' ? '#0369a1' : (item.badge === 'emerald' ? '#047857' : '#be123c'))
              : textFill;

            svgParts.push(
              `<text x="${cx.toFixed(3)}" y="${cy.toFixed(3)}" fill="${badgeTextColor}" font-size="${charFontSize}" font-weight="${item.badge ? '700' : '600'}" text-anchor="middle" dominant-baseline="central" class="font-kyokasho"${transformAttr}>${escapeXml(item.char)}</text>`
            );
          }

          // ふりがな（ルビ）描画
          if (state.hasFurigana && item.ruby) {
            const rubyChars = Array.from(item.ruby);
            const rCount = rubyChars.length;
            if (isVertical) {
              const furiColX = cellX + cellSize + (cellSize * furiganaRatio) / 2;
              rubyChars.forEach((rc, rIdx) => {
                const ry = cellY + ((rIdx + 0.5) * cellSize) / rCount;
                svgParts.push(
                  `<text x="${furiColX.toFixed(3)}" y="${ry.toFixed(3)}" fill="${textFill}" font-size="${rubyFontSize}" font-weight="600" text-anchor="middle" dominant-baseline="central" class="font-kyokasho">${escapeXml(rc)}</text>`
                );
              });
            } else {
              const furiRowY = l * unitTrack + (cellSize * furiganaRatio) / 2;
              rubyChars.forEach((rc, rIdx) => {
                const rx = cellX + ((rIdx + 0.5) * cellSize) / rCount;
                svgParts.push(
                  `<text x="${rx.toFixed(3)}" y="${furiRowY.toFixed(3)}" fill="${textFill}" font-size="${rubyFontSize}" font-weight="600" text-anchor="middle" dominant-baseline="central" class="font-kyokasho">${escapeXml(rc)}</text>`
                );
              });
            }
          }
        }

        // ≪吹き出しメモ≫ 描画（ノート見本用の指導コメント）
        if (rowData.callout) {
          const memoText = rowData.callout;
          if (isVertical) {
            const memoX = (numLines - 1 - l) * unitTrack + unitTrack / 2;
            const memoY = Math.min(totalGridH - 2, (maxCells + 0.4) * cellSize);
            svgParts.push(
              `<g transform="translate(${memoX.toFixed(3)}, ${memoY.toFixed(3)})">
                <rect x="-2.4" y="0" width="4.8" height="${(memoText.length * 2.8 + 2.4).toFixed(2)}" rx="1.2" fill="#fffbeb" stroke="#d97706" stroke-width="0.3"/>
                <text x="0" y="1.4" fill="#b45309" font-size="2.5" font-weight="700" text-anchor="middle" style="writing-mode: vertical-rl;">${escapeXml(memoText)}</text>
              </g>`
            );
          } else {
            const memoX = Math.min(totalGridW - 22, (maxCells + 0.3) * cellSize);
            const memoY = l * unitTrack + unitTrack / 2;
            const boxW = Math.max(14, memoText.length * 2.7 + 3);
            svgParts.push(
              `<g transform="translate(${memoX.toFixed(3)}, ${memoY.toFixed(3)})">
                <rect x="0" y="-2.4" width="${boxW.toFixed(2)}" height="4.8" rx="1.2" fill="#fffbeb" stroke="#d97706" stroke-width="0.3"/>
                <text x="${(boxW / 2).toFixed(2)}" y="0" fill="#b45309" font-size="2.5" font-weight="700" text-anchor="middle" dominant-baseline="central">${escapeXml(memoText)}</text>
              </g>`
            );
          }
        }
      }

      // 外枠を1つのrectで閉じる
      svgParts.push(
        `<rect x="0" y="0" width="${totalGridW}" height="${totalGridH}" fill="none" stroke="${palette.bold}" stroke-width="0.4"/>`
      );

      // 上部ヘッダー（年・組・番・なまえ）
      const headerHtml = state.showHeader
        ? `<div style="height:${headerH}mm; color:${palette.text}; border-bottom: 0.35mm solid ${palette.main};" class="w-full flex items-end justify-between pb-1.5 mb-2 shrink-0">
            <div class="font-black text-[13pt] tracking-tight truncate pr-3">${escapeHtml(state.sheetTitle)}</div>
            <div class="text-[10.5pt] font-bold whitespace-nowrap flex items-baseline">
              <span class="inline-block w-[8mm]"></span><span>年</span>
              <span class="inline-block w-[8mm]"></span><span>組</span>
              <span class="inline-block w-[8mm]"></span><span>番</span>
              <span class="ml-3">なまえ（</span><span class="inline-block w-[36mm]"></span><span>）</span>
            </div>
          </div>`
        : '';

      const sheet = document.getElementById('paperSheet');
      sheet.style.width = `${paperW}mm`;
      sheet.style.height = `${paperH}mm`;
      sheet.style.padding = `${margin}mm`;

      const pad = 0.3;
      const svgW = +(totalGridW + pad * 2).toFixed(3);
      const svgH = +(totalGridH + pad * 2).toFixed(3);

      sheet.innerHTML = `
        ${headerHtml}
        <div class="flex-1 flex items-center justify-center">
          <svg width="${svgW}mm" height="${svgH}mm" viewBox="${-pad} ${-pad} ${svgW} ${svgH}" xmlns="http://www.w3.org/2000/svg">
            ${svgParts.join('')}
          </svg>
        </div>
      `;

      applyPreviewScale();
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[m]));
    }

    function escapeXml(str) {
      return str.replace(/[&<>"']/g, m => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;'
      }[m]));
    }

    // ==========================================
    // 6. UIイベント・プリセット連動
    // ==========================================
    function syncUiButtons() {
      // 視写モードボタン
      document.querySelectorAll('.shisha-mode-btn').forEach(btn => {
        if (btn.dataset.mode === state.shishaMode) {
          btn.className = 'shisha-mode-btn py-1.5 px-1 rounded-lg bg-white text-slate-900 shadow-2xs transition';
        } else {
          btn.className = 'shisha-mode-btn py-1.5 px-1 rounded-lg text-slate-500 hover:text-slate-900 transition';
        }
      });

      // 用紙ボタン
      document.querySelectorAll('.paper-btn').forEach(btn => {
        if (btn.dataset.paper === state.paper) {
          btn.className = 'paper-btn py-2 rounded-xl bg-indigo-600 text-white font-mono-tech font-black text-xs shadow-2xs transition';
        } else {
          btn.className = 'paper-btn py-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 font-mono-tech font-black text-xs transition';
        }
      });

      // 用紙向き
      const pBtn = document.getElementById('orientPortraitBtn');
      const lBtn = document.getElementById('orientLandscapeBtn');
      if (state.orientation === 'portrait') {
        pBtn.className = 'flex-1 py-1.5 rounded-lg bg-white text-slate-900 shadow-2xs transition';
        lBtn.className = 'flex-1 py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
      } else {
        lBtn.className = 'flex-1 py-1.5 rounded-lg bg-white text-slate-900 shadow-2xs transition';
        pBtn.className = 'flex-1 py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
      }

      // 書字方向
      const vBtn = document.getElementById('dirVerticalBtn');
      const hBtn = document.getElementById('dirHorizontalBtn');
      if (state.direction === 'vertical') {
        vBtn.className = 'flex-1 py-1.5 rounded-lg bg-white text-indigo-700 shadow-2xs transition';
        hBtn.className = 'flex-1 py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
        document.getElementById('charsPerLineLabel').textContent = '1行のマス数（縦の字数）';
        document.getElementById('linesCountLabel').textContent = '全体の行数（横の列数）';
      } else {
        hBtn.className = 'flex-1 py-1.5 rounded-lg bg-white text-indigo-700 shadow-2xs transition';
        vBtn.className = 'flex-1 py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
        document.getElementById('charsPerLineLabel').textContent = '1行のマス数（横の字数）';
        document.getElementById('linesCountLabel').textContent = '全体の行数（縦の段数）';
      }

      // マス指定モード
      const cntBtn = document.getElementById('modeCountBtn');
      const mmBtn = document.getElementById('modeMmBtn');
      if (state.sizeMode === 'count') {
        cntBtn.className = 'py-1.5 rounded-lg bg-white text-slate-900 shadow-2xs transition';
        mmBtn.className = 'py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
        document.getElementById('countControlPanel').classList.remove('hidden');
        document.getElementById('mmControlPanel').classList.add('hidden');
      } else {
        mmBtn.className = 'py-1.5 rounded-lg bg-white text-slate-900 shadow-2xs transition';
        cntBtn.className = 'py-1.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
        document.getElementById('mmControlPanel').classList.remove('hidden');
        document.getElementById('countControlPanel').classList.add('hidden');
      }

      // mmチップ
      document.querySelectorAll('.mm-chip').forEach(chip => {
        if (parseFloat(chip.dataset.mm) === state.cellMm) {
          chip.className = 'mm-chip px-2.5 py-1 rounded-lg bg-indigo-100 text-indigo-800 ring-2 ring-indigo-400 font-mono-tech font-black text-xs';
        } else {
          chip.className = 'mm-chip px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-mono-tech font-bold text-xs';
        }
      });

      // カラーボタン
      document.querySelectorAll('.color-btn').forEach(btn => {
        const c = btn.dataset.color;
        if (c === state.color) {
          const activeStyles = {
            black: 'border-2 border-slate-800 bg-slate-800 text-white',
            blue: 'border-2 border-sky-600 bg-sky-600 text-white',
            green: 'border-2 border-emerald-600 bg-emerald-600 text-white'
          };
          btn.className = `color-btn py-2 rounded-xl ${activeStyles[c]} font-black text-xs transition flex items-center justify-center gap-1`;
        } else {
          const idleText = { black: 'text-slate-700', blue: 'text-sky-700', green: 'text-emerald-700' };
          btn.className = `color-btn py-2 rounded-xl border border-slate-200 bg-white ${idleText[c]} font-black text-xs transition flex items-center justify-center gap-1`;
        }
      });

      // 見本隠しボタン
      const hideBtn = document.getElementById('toggleHideModelBtn');
      if (state.hideModelText) {
        hideBtn.className = 'px-2.5 py-1 rounded-xl bg-amber-500 text-white font-black text-[11px] transition flex items-center gap-1';
        hideBtn.innerHTML = '<i data-lucide="eye" class="w-3.5 h-3.5"></i><span>見本を表示</span>';
      } else {
        hideBtn.className = 'px-2.5 py-1 rounded-xl bg-slate-100 hover:bg-amber-100 text-slate-700 font-black text-[11px] transition flex items-center gap-1';
        hideBtn.innerHTML = '<i data-lucide="eye-off" class="w-3.5 h-3.5"></i><span>見本隠し</span>';
      }
      lucide.createIcons();

      // フォーム値同期
      document.getElementById('sourceTextInput').value = state.rawText;
      document.getElementById('charsPerLineInput').value = state.charsPerLine;
      document.getElementById('linesCountInput').value = state.linesCount;
      document.getElementById('cellSizeMmInput').value = state.cellMm;
      document.getElementById('furiganaColCheck').checked = state.hasFurigana;
      document.getElementById('crossLeaderCheck').checked = state.crossLeader;
      document.getElementById('traceShadeSelect').value = state.traceShade;
      document.getElementById('showHeaderCheck').checked = state.showHeader;
      document.getElementById('sheetTitleInput').value = state.sheetTitle;
    }

    function applyPreset(presetName) {
      if (presetName === 'shisha_low') {
        Object.assign(state, {
          paper: 'A4', orientation: 'portrait', direction: 'vertical', shishaMode: 'copy_blank',
          sizeMode: 'count', charsPerLine: 12, linesCount: 8, hasFurigana: true, crossLeader: true,
          color: 'green', showHeader: true, sheetTitle: 'ししゃ プリント',
          rawText: '　春(はる)の　朝(あさ)、\n小さな　花が　さきました。\n「きれいだな。」\nと、声(こえ)が　出ました。'
        });
      } else if (presetName === 'shisha_trace') {
        Object.assign(state, {
          paper: 'A4', orientation: 'portrait', direction: 'vertical', shishaMode: 'trace_blank',
          sizeMode: 'count', charsPerLine: 10, linesCount: 8, hasFurigana: true, crossLeader: true,
          color: 'green', traceShade: 'normal', showHeader: true, sheetTitle: 'なぞりがき れんしゅう',
          rawText: '　あいうえお　かきくけこ\n　お日さまが　のぼる。\n　元気(げんき)に　あいさつ。\n　ありがとう。'
        });
      } else if (presetName === 'shisha_mid') {
        Object.assign(state, {
          paper: 'A4', orientation: 'portrait', direction: 'vertical', shishaMode: 'copy_blank',
          sizeMode: 'count', charsPerLine: 15, linesCount: 10, hasFurigana: true, crossLeader: false,
          color: 'green', showHeader: true, sheetTitle: '視写プリント',
          rawText: '　自然(しぜん)の中(なか)には、\nたくさんの　ふしぎが\nかくれている。\n　よく　観察(かんさつ)して、\n発見(はっけん)を　記録(きろく)しよう。'
        });
      } else if (presetName === 'note_kokugo') {
        Object.assign(state, {
          paper: 'B5', orientation: 'portrait', direction: 'vertical', shishaMode: 'model_only',
          sizeMode: 'count', charsPerLine: 15, linesCount: 10, hasFurigana: true, crossLeader: false,
          color: 'green', showHeader: true, sheetTitle: '国語ノートの書き方見本',
          rawText: '　十一月二十五日（水）≪日付を書く≫\n【めあて】場面(ばめん)の様子(ようす)を想像(そうぞう)しよう。\n\n　主人公(しゅじんこう)の気持(きも)ちが\n変化(へんか)した　理由(りゆう)は、\n友(とも)だちの　言葉(ことば)にある。≪１マスあける≫\n\n【まとめ】会話文(かいわぶん)に気をつけて読むと\n気持(きも)ちの変化(へんか)がよくわかる。'
        });
      } else if (presetName === 'shisha_horiz') {
        Object.assign(state, {
          paper: 'A4', orientation: 'portrait', direction: 'horizontal', shishaMode: 'copy_blank',
          sizeMode: 'count', charsPerLine: 16, linesCount: 10, hasFurigana: false, crossLeader: false,
          color: 'blue', showHeader: true, sheetTitle: 'よこがき 視写プリント',
          rawText: 'きょうは　いい　てんきです。\nみんなで　きょうりょくしよう。\n目標(もくひょう)を　もって\nまいにち　がんばろう。'
        });
      }
      syncUiButtons();
      renderSheet();
    }

    document.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();

      // プリセット
      document.querySelectorAll('.preset-chip').forEach(btn => {
        btn.onclick = () => applyPreset(btn.dataset.preset);
      });

      // 出力パターン
      document.querySelectorAll('.shisha-mode-btn').forEach(btn => {
        btn.onclick = () => {
          state.shishaMode = btn.dataset.mode;
          syncUiButtons();
          renderSheet();
        };
      });

      // テキスト入力＆クリア
      const textArea = document.getElementById('sourceTextInput');
      textArea.oninput = (e) => {
        state.rawText = e.target.value;
        renderSheet();
      };
      document.getElementById('clearTextBtn').onclick = () => {
        state.rawText = '';
        textArea.value = '';
        renderSheet();
      };

      // ワンクリックタグ挿入
      document.querySelectorAll('.insert-tag-btn').forEach(btn => {
        btn.onclick = () => {
          const tag = btn.dataset.insert;
          const start = textArea.selectionStart;
          const end = textArea.selectionEnd;
          const cur = textArea.value;
          textArea.value = cur.slice(0, start) + tag + cur.slice(end);
          state.rawText = textArea.value;
          textArea.focus();
          textArea.selectionStart = textArea.selectionEnd = start + tag.length;
          renderSheet();
        };
      });

      // 用紙サイズ・向き・書字方向
      document.querySelectorAll('.paper-btn').forEach(btn => {
        btn.onclick = () => {
          state.paper = btn.dataset.paper;
          syncUiButtons();
          renderSheet();
        };
      });
      document.getElementById('orientPortraitBtn').onclick = () => {
        state.orientation = 'portrait';
        syncUiButtons();
        renderSheet();
      };
      document.getElementById('orientLandscapeBtn').onclick = () => {
        state.orientation = 'landscape';
        syncUiButtons();
        renderSheet();
      };
      document.getElementById('dirVerticalBtn').onclick = () => {
        state.direction = 'vertical';
        syncUiButtons();
        renderSheet();
      };
      document.getElementById('dirHorizontalBtn').onclick = () => {
        state.direction = 'horizontal';
        syncUiButtons();
        renderSheet();
      };

      // マス指定モード
      document.getElementById('modeCountBtn').onclick = () => {
        state.sizeMode = 'count';
        syncUiButtons();
        renderSheet();
      };
      document.getElementById('modeMmBtn').onclick = () => {
        state.sizeMode = 'mm';
        syncUiButtons();
        renderSheet();
      };

      // マス数入力
      document.getElementById('charsPerLineInput').oninput = (e) => {
        const val = parseInt(e.target.value, 10);
        if (!isNaN(val) && val >= 4 && val <= 40) {
          state.charsPerLine = val;
          renderSheet();
        }
      };
      document.getElementById('linesCountInput').oninput = (e) => {
        const val = parseInt(e.target.value, 10);
        if (!isNaN(val) && val >= 2 && val <= 30) {
          state.linesCount = val;
          renderSheet();
        }
      };

      // mm指定入力
      document.querySelectorAll('.mm-chip').forEach(chip => {
        chip.onclick = () => {
          state.cellMm = parseFloat(chip.dataset.mm);
          syncUiButtons();
          renderSheet();
        };
      });
      document.getElementById('cellSizeMmInput').oninput = (e) => {
        const val = parseFloat(e.target.value);
        if (!isNaN(val) && val >= 5 && val <= 40) {
          state.cellMm = val;
          syncUiButtons();
          renderSheet();
        }
      };

      // オプション
      document.getElementById('furiganaColCheck').onchange = (e) => {
        state.hasFurigana = e.target.checked;
        renderSheet();
      };
      document.getElementById('crossLeaderCheck').onchange = (e) => {
        state.crossLeader = e.target.checked;
        renderSheet();
      };

      // カラー・濃さ・ヘッダー
      document.querySelectorAll('.color-btn').forEach(btn => {
        btn.onclick = () => {
          state.color = btn.dataset.color;
          syncUiButtons();
          renderSheet();
        };
      });
      document.getElementById('traceShadeSelect').onchange = (e) => {
        state.traceShade = e.target.value;
        renderSheet();
      };
      document.getElementById('showHeaderCheck').onchange = (e) => {
        state.showHeader = e.target.checked;
        renderSheet();
      };
      document.getElementById('sheetTitleInput').oninput = (e) => {
        state.sheetTitle = e.target.value;
        renderSheet();
      };

      // 見本隠しトグル
      document.getElementById('toggleHideModelBtn').onclick = () => {
        state.hideModelText = !state.hideModelText;
        syncUiButtons();
        renderSheet();
      };

      // ズーム切替
      const zoomFitBtn = document.getElementById('zoomFitBtn');
      const zoom100Btn = document.getElementById('zoom100Btn');
      zoomFitBtn.onclick = () => {
        state.zoomMode = 'fit';
        zoomFitBtn.className = 'px-2.5 py-0.5 rounded-lg bg-white text-slate-900 shadow-2xs transition';
        zoom100Btn.className = 'px-2.5 py-0.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
        applyPreviewScale();
      };
      zoom100Btn.onclick = () => {
        state.zoomMode = '100';
        zoom100Btn.className = 'px-2.5 py-0.5 rounded-lg bg-white text-slate-900 shadow-2xs transition';
        zoomFitBtn.className = 'px-2.5 py-0.5 rounded-lg text-slate-500 hover:text-slate-900 transition';
        applyPreviewScale();
      };

      // 印刷
      document.getElementById('headerPrintBtn').onclick = () => window.print();

      window.addEventListener('resize', applyPreviewScale);

      syncUiButtons();
      renderSheet();
    });
  </script>
</body>
</html>
